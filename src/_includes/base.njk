<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>

<header class="site-header">
    <div class="site-title-wrap">
        <div class="site-title">Cultivating Lives for Life</div>
        <div class="site-tagline">Richard Langston Therapy Services</div>
    </div>

    <nav class="main-nav">
        <div class="wrap nav-inner">
            <a href="/">Home</a>
            <a href="#">Services</a>
            <a href="#">About</a>
            <a href="#">Resources</a>
            <a href="#">Supervision</a>
            <a href="#">FAQ</a>
            <a href="#">Contact</a>
            <a href="#">Blog</a>
        </div>
    </nav>
</header>

<main>

<section class="hero">
    <div class="wrap">
        <h1>{{ hero.heading }}</h1>
        <h3>{{ hero.subheading }}</h3>
        <p class="hero-lead">{{ hero.lead }}</p>
        <p class="hero-message">{{ hero.message }}</p>
        <p class="availability">{{ hero.availability }}</p>
    </div>
</section>

<section class="therapists wrap">
    {% for therapist in therapists %}
    <article class="therapist-card">
        <div class="photo-placeholder">
            Photo
        </div>
        <div>
            <h2>{{ therapist.name }}</h2>
            <p class="therapist-title">{{ therapist.title }}</p>
            <p>{{ therapist.description }}</p>
        </div>
    </article>
    {% endfor %}
</section>

<section class="content-section">
    <div class="wrap content-grid">
        <article class="main-copy">
            {{ content | safe }}
        </article>

        <aside class="sidebar">
            <section class="mission-box">
                <h2>{{ mission.heading }}</h2>
                <p>{{ mission.text }}</p>
            </section>

            <section class="contact-box">
                <h3>For more information or to make an appointment</h3>
                <p><strong>Phone:</strong> {{ contact.phone }}</p>
                <p><strong>Email:</strong> {{ contact.email }}</p>
                <p>{{ contact.address }}</p>
                <p><strong>Serving:</strong><br>{{ contact.serving }}</p>
            </section>
        </aside>
    </div>
</section>

</main>

<footer class="site-footer">
    <div class="wrap">
        Copyright © 2026 Cultivating Lives for Life
    </div>
</footer>

</body>
</html>
